    r"C:\Program Files\Havok\HavokContentTools",
    r"C:\Program Files (x86)\Havok\HavokContentTools",
    r"D:\Program Files\Havok\HavokContentTools",
    r"D:\Program Files (x86)\Havok\HavokContentTools",
]


def auto_detect_havok_path():
    """Auto-detect Havok Content Tools installation path."""
    for path in HAVOK_SEARCH_PATHS:
        if os.path.isdir(path):
            filter_manager = os.path.join(path, "hctStandAloneFilterManager.exe")
            if os.path.exists(filter_manager):
                return path
    return ""

